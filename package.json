{
  "name": "gmail-mcp-http",
  "version": "2.1.1",
  "description": "Gmail MCP Server — Streamable HTTP, broker-first auth (Connections Broker)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/public && cp -r src/public/* dist/public/",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "exceljs": "4.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "yauzl": "3.4.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/yauzl": "3.4.0",
    "jszip": "3.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
